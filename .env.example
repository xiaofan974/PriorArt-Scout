# Server-side only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Must be the string "true" to call OpenAI. Leave unset in production
# until durable abuse protection is in place.
LIVE_EXTRACTION_ENABLED=true

# Public UI flag only (not a secret). Set to true in local/preview only.
# Production should omit this so the UI does not advertise live extraction.
VITE_LIVE_EXTRACTION_ENABLED=true

# Server-side only. Must be the string "true" to call EPO OPS.
# Leave unset until durable abuse protection is configured. Do not prefix with VITE_.
LIVE_EPO_ENABLED=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# Public UI flag only (not a secret). Production should omit this.
VITE_LIVE_EPO_ENABLED=
